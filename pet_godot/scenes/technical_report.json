{
  "id": "technical_report",
  "title": "วิเคราะห์เทคนิคอล",
  "mood": "analytical",
  "needs": "technical",
  "tags": ["technical", "indicator", "rsi", "macd", "signal", "info", "trading_technical_analysis"],
  "description": "ผลของ trading_technical_analysis: หน้าปัด 3D สัญญาณรวม (ขายแรง…ซื้อแรง), หน้าปัด RSI พร้อมโซน Oversold/Overbought, ช่องตัวเลข MACD / ADX / ATR และจำนวนอินดิเคเตอร์ที่ชี้ซื้อ/ขาย/กลาง",
  "duration": 13.0,
  "beats": [
    {"t": 0.0, "do": "caption", "text": "เทคนิคอล {symbol}", "dur": 1.1},
    {"t": 0.0, "do": "background", "name": "cyber"},
    {"t": 0.0, "do": "wear", "item": "headphones"},
    {"t": 0.0, "do": "emotion", "name": "talk"},
    {"t": 0.2, "do": "move", "to": [-0.6, -1.1, -1.0], "dur": 0.7, "ease": "back"},
    {"t": 0.6, "do": "present", "side": "R"},
    {"t": 1.0, "do": "panel", "id": "main", "type": "gauge", "at": "top", "beam": "R",
      "title": "สัญญาณรวม · {symbol}", "subtitle": "{interval}",
      "value": "{score}", "min": -1, "max": 1, "text": "{signal}", "label": "{signal_th}", "min_text": "ขายแรง", "max_text": "ซื้อแรง",
      "zones": [
        {"to": -0.5, "color": "#FF4D5E", "label": "ขายแรง"},
        {"to": -0.1, "color": "#FF9A4C", "label": "ขาย"},
        {"to": 0.1, "color": "#9AA7B8", "label": "กลาง"},
        {"to": 0.5, "color": "#9BE36B", "label": "ซื้อ"},
        {"to": 1.0, "color": "#3DDC97", "label": "ซื้อแรง"}
      ]},
    {"t": 2.4, "do": "say", "text": "สัญญาณรวม: {signal_th}", "dur": 2.0},

    {"t": 4.8, "do": "panel", "id": "main", "type": "gauge", "at": "top", "beam": "R",
      "title": "RSI (14) · {symbol}", "subtitle": "โซน 30 / 70",
      "value": "{RSI}", "min": 0, "max": 100, "text": "{RSI:1}",
      "zones": [
        {"to": 30, "color": "#4FA3FF", "label": "Oversold"},
        {"to": 70, "color": "#9AA7B8", "label": ""},
        {"to": 100, "color": "#FF9A4C", "label": "Overbought"}
      ]},
    {"t": 6.0, "do": "say", "text": "RSI {RSI:1} อยู่โซนขายมากเกินไป", "dur": 2.0, "if": "rsi_zone == oversold"},
    {"t": 6.0, "do": "say", "text": "RSI {RSI:1} อยู่โซนซื้อมากเกินไป", "dur": 2.0, "if": "rsi_zone == overbought"},
    {"t": 6.0, "do": "say", "text": "RSI {RSI:1} อยู่กลางๆ", "dur": 2.0, "if": "rsi_zone == neutral"},
    {"t": 6.2, "do": "tilt_head", "deg": 10, "dur": 0.3},

    {"t": 8.6, "do": "panel", "id": "main", "type": "kpi", "at": "top", "beam": "R", "columns": 3,
      "title": "อินดิเคเตอร์ · {symbol}", "items": [
        {"label": "MACD", "value": "{MACD.macd:2}", "sub": "สัญญาณ {MACD.signal:2}", "good": "{macd_bull}"},
        {"label": "ADX", "value": "{ADX:1}", "sub": "เทรนด์แรง ≥ 25"},
        {"label": "ATR", "value": "{ATR:2}", "sub": "ความผันผวน"},
        {"label": "RSI (14)", "value": "{RSI:1}", "sub": "30 / 70"},
        {"label": "เส้นกลาง BB", "value": "{BB.basis:group}", "sub": "Bollinger 20"},
        {"label": "ราคาปิด", "value": "{close:group}", "sub": "{change:pct+} วันนี้", "good": "{day_up}"}
      ]},
    {"t": 8.8, "do": "tilt_head", "deg": 0, "dur": 0.3},
    {"t": 9.6, "do": "say", "text": "MACD {macd_word}\nเทรนด์{trend_word}", "dur": 2.2},
    {"t": 10.2, "do": "panel", "id": "note", "type": "text", "at": "bottom_right", "size": [1.3, 0.5], "text": "{advice}", "if": "advice"},
    {"t": 11.8, "do": "hold"},
    {"t": 12.3, "do": "present", "side": "R", "on": false}
  ]
}
