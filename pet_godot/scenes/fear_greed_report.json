{
  "id": "fear_greed_report",
  "title": "Fear & Greed",
  "mood": "analytical",
  "needs": "fear_greed",
  "tags": ["fear_greed", "sentiment", "crypto", "market_mood", "info", "trading_fear_greed"],
  "description": "ผลของ trading_fear_greed: หน้าปัด 3D 0-100 ห้าโซน (กลัวสุดขีด…โลภสุดขีด) เข็มดีดไปที่ค่าจริง พร้อมกราฟแท่ง 7 วันล่าสุด หุ่นตัวสั่นเมื่อตลาดกลัวสุดขีด ใส่แว่นดำเมื่อโลภสุดขีด",
  "duration": 10.0,
  "beats": [
    {"t": 0.0, "do": "caption", "text": "อารมณ์ตลาดคริปโต", "dur": 1.1},
    {"t": 0.0, "do": "background", "name": "space"},
    {"t": 0.0, "do": "emotion", "name": "talk"},
    {"t": 0.2, "do": "move", "to": [-0.6, -1.1, -1.0], "dur": 0.7, "ease": "back"},
    {"t": 0.6, "do": "present", "side": "R"},
    {"t": 1.0, "do": "panel", "id": "dial", "type": "gauge", "at": "top", "beam": "R",
      "title": "Fear & Greed Index", "subtitle": "alternative.me", "value": "{fg}", "min": 0, "max": 100,
      "label": "{fg_th} · {classification}",
      "zones": [
        {"to": 25, "color": "#FF4D5E", "label": "กลัวสุด"},
        {"to": 45, "color": "#FF9A4C", "label": "กลัว"},
        {"to": 55, "color": "#FFD24A", "label": ""},
        {"to": 75, "color": "#9BE36B", "label": "โลภ"},
        {"to": 100, "color": "#3DDC97", "label": "โลภสุด"}
      ]},
    {"t": 2.4, "do": "say", "text": "ดัชนี {fg:0} — ตลาด{fg_th}", "dur": 2.2},

    {"t": 4.8, "do": "eyes", "name": "surprised", "dur": 1.8, "if": "fg_zone == extreme_fear"},
    {"t": 4.8, "do": "vibrate", "amount": 0.04, "dur": 1.2, "if": "fg_zone == extreme_fear"},
    {"t": 4.9, "do": "emote", "kind": "sweat", "count": 2, "if": "fg_zone in [extreme_fear, fear]"},
    {"t": 4.8, "do": "wear", "item": "sunglasses", "if": "fg_zone == extreme_greed"},
    {"t": 4.9, "do": "emote", "kind": "star", "count": 3, "if": "fg_zone in [greed, extreme_greed]"},
    {"t": 4.8, "do": "tilt_head", "deg": 10, "dur": 0.3, "if": "fg_zone == neutral"},

    {"t": 5.6, "do": "panel", "id": "week", "type": "bars", "at": "bottom_right", "size": [1.3, 0.85], "money": false,
      "title": "7 วันล่าสุด", "bars": "{fg_days}", "if": "fg_days"},
    {"t": 8.6, "do": "hold"},
    {"t": 9.3, "do": "present", "side": "R", "on": false}
  ]
}
