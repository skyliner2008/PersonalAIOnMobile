# ============================================================================
# mt5-core-server — Environment Variables
# ============================================================================
# Copy this file to `.env` and fill in REAL values before starting the server.
# ไฟล์ .env ตัวจริงห้าม commit ลง git (ถูก ignore ไว้แล้ว)
# ============================================================================

# -----------------------------------------------------------------------------
# REQUIRED — Security secrets (≥24 chars random)
# -----------------------------------------------------------------------------
# Generate random secrets:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN=REPLACE_ME_WITH_RANDOM_32BYTES_HEX
TOKEN_PEPPER=REPLACE_ME_WITH_RANDOM_32BYTES_HEX

# Encryption key for securing sensitive data in the database (API Keys, etc.)
# MUST be 32 characters or longer.
DB_ENCRYPTION_KEY=REPLACE_ME_WITH_RANDOM_32BYTES_HEX

# -----------------------------------------------------------------------------
# REQUIRED — HTTP server
# -----------------------------------------------------------------------------
PORT=8090

# Logging Level: fatal, error, warn, info, debug, trace
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# Recommended — CORS allowlist (comma-separated origins)
# -----------------------------------------------------------------------------
# ว่าง = อนุญาต localhost/127.0.0.1 ทุก port เท่านั้น (loopback only)
# ตัวอย่าง: CORS_ORIGIN=http://localhost:3000,https://app.example.com
MINIMAX_API_KEY=
CORS_ORIGIN=

# -----------------------------------------------------------------------------
# MT5 Python Bridge
# -----------------------------------------------------------------------------
MT5_BRIDGE_URL=http://127.0.0.1:5001
MT5_BRIDGE_TOKEN=
# เปิด bridge auto-start (1 = เปิด, 0 = ปิด)
BRIDGE_AUTO_START=1
# คำสั่ง start Python bridge (ว่าง = ใช้ default `python bridge/mt5_bridge.py`)
# ตัวอย่าง: BRIDGE_START_CMD=python C:\\mt5-bridge\\app.py
BRIDGE_START_CMD=

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
DB_PATH=./data/mt5-core.db

# -----------------------------------------------------------------------------
# Google Cloud Vertex AI (ADC — Application Default Credentials)
# -----------------------------------------------------------------------------
# ใช้ gcloud auth application-default login สำหรับ development
# หรือตั้ง GOOGLE_APPLICATION_CREDENTIALS สำหรับ production (Service Account JSON)
VERTEX_PROJECT_ID=
VERTEX_LOCATION=us-central1
