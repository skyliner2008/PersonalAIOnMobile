{
  "name": "mt5-core-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "analyze": "node scripts/advanced_analytics.mjs",
    "analytics:gate": "node scripts/gate_analytics.mjs",
    "analytics:audit": "node scripts/gate_flow_audit.mjs",
    "analytics:help": "node scripts/analytics_help.mjs",
    "analyze:logs": "python scripts/analyze_logs.py",
    "analyze:deep": "python scripts/deep_analysis.py"
  },
  "dependencies": {
    "@google/adk": "^1.2.0",
    "@google/generative-ai": "^0.24.1",
    "@huggingface/transformers": "^4.2.0",
    "better-sqlite3": "^12.6.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.1",
    "google-auth-library": "^10.6.2",
    "hnswlib-node": "^3.0.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "prom-client": "^15.1.3",
    "ws": "^8.20.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.19.17",
    "@types/pino-http": "^5.8.4",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.1.5",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.5"
  }
}
