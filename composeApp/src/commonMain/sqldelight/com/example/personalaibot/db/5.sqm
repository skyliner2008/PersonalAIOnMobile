-- Migration v5 → v6: ตาราง OptimizationTrial (Adaptive Optimize learning memory)
-- บันทึกผลการลอง params แต่ละครั้ง → ระบบเรียนรู้ว่าปรับทิศไหนแล้วผลดี/แย่
CREATE TABLE IF NOT EXISTS OptimizationTrial (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    symbol TEXT NOT NULL,
    interval TEXT NOT NULL,
    kind TEXT NOT NULL,
    sl_mult REAL NOT NULL,
    tp_mult REAL NOT NULL,
    score REAL NOT NULL,
    expectancy_r REAL,
    profit_factor REAL,
    trades INTEGER,
    delta_vs_baseline REAL,
    applied INTEGER NOT NULL DEFAULT 0,
    source TEXT NOT NULL DEFAULT 'adaptive',
    created_at INTEGER NOT NULL
);
