-- คอลัมน์ต่อท้ายตาราง (ALTER TABLE) — ลำดับตรงกับนิยามใน JarvisDatabase.sq
ALTER TABLE AnticipationFactorOutcome ADD COLUMN ai_confidence INTEGER;
ALTER TABLE AnticipationFactorOutcome ADD COLUMN ai_reason TEXT;
