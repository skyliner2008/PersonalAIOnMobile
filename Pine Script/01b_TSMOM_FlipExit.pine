//@version=6
// ═══════════════════════════════════════════════════════════════════════════
//  01b · TSMOM — Flip Exit + Regime Filter [PAIBot]
//  จุดประสงค์: แก้อาการ "สัญญาณกระจุกถี่ในช่วง sideway" ของ MOM บน TF เล็ก
//  สาเหตุ: ROC = close − close[16] ข้ามศูนย์ทุกครั้งที่ราคาแกว่งผ่าน anchor
//          → ทุก wiggle กลายเป็นไม้เทรด (whipsaw)
//
//  Filter 2 ชั้น (เปิด/ปิดได้อิสระ):
//   · ADX regime — เทรดเฉพาะตลาดมีเทรนด์ (ADX ≥ threshold)
//   · ROC magnitude — flip ต้องใหญ่พอ (|ROC| ≥ minRocAtr × ATR14) ตัด flip จิ๋ว
//
//  Entry เหมือน 01 เป๊ะ (ROC flip edge) — prevSign track แบบไม่ผ่าน filter
//  (ถ้า flip ตอน ADX ต่ำแล้ว ADX ขึ้นภายหลัง จะไม่ยิงย้อนหลัง — ต้องรอ flip ใหม่)
//
//  Exit mode: FLIP (ถือจน ROC พลิก) / TRAIL (chandelier) / PARTIAL (50%@R + trail)
//  ขนาดไม้ default 20% equity — ตัดปัญหา margin call ตอนเทสต์ SL กว้าง
// ═══════════════════════════════════════════════════════════════════════════
strategy("01b · TSMOM — Flip Exit + Filter [PAIBot]", shorttitle="TSMOM-FX", overlay=true,
     initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=20,
     process_orders_on_close=true, calc_on_every_tick=false)

// ── Inputs: Entry ───────────────────────────────────────────────────────────
lookback  = input.int(16,     "ROC lookback", minval=2, group="Entry",
     tooltip="16 = ค่าที่ทดสอบแล้วเหมาะกับ M15/H1/H4 (Kotlin default = 20)")

// ── Inputs: Filter (ตัดสัญญาณกระจุกในช่วง sideway) ──────────────────────────
useAdx    = input.bool(true,  "ใช้ ADX regime filter", group="Filter")
adxLen    = input.int(14,     "ADX period", minval=2, group="Filter")
adxMin    = input.float(20.0, "ADX ขั้นต่ำ (≥ = มีเทรนด์)", step=1.0, group="Filter")
useRocF   = input.bool(true,  "ใช้ ROC magnitude filter", group="Filter")
rocMinAtr = input.float(0.5,  "|ROC| ขั้นต่ำ (×ATR14)", step=0.1, group="Filter")

// ── Inputs: Exit ────────────────────────────────────────────────────────────
exitMode  = input.string("FLIP", "Exit mode", options=["FLIP", "TRAIL", "PARTIAL"], group="Exit",
     tooltip="FLIP = ถือจน ROC พลิก (native TSMOM) · TRAIL = chandelier trailing · PARTIAL = ปิดครึ่งที่ partialR แล้ว trail ต่อ")
slBuf     = input.float(1.5,  "SL กันหายนะ = swing + buf ×ATR14", step=0.1, group="Exit")
trailMult = input.float(3.0,  "Trailing mult (×ATR14 จากจุดสูงสุดหลังเข้า)", step=0.1, group="Exit")
partialR  = input.float(1.5,  "PARTIAL: ปิด 50% ที่ RR นี้", step=0.1, group="Exit")
swingLen  = input.int(10,     "Swing lookback (bars)", minval=2, group="Exit")

// ── Indicators ──────────────────────────────────────────────────────────────
atr14   = ta.atr(14)
swingLo = ta.lowest(low, swingLen)[1]
swingHi = ta.highest(high, swingLen)[1]
[diP, diM, adxV] = ta.dmi(adxLen, adxLen)

// ── Entry: ROC flip edge (เหมือน 01 เป๊ะ) + filter ──────────────────────────
roc = close - close[lookback]
sgn = roc > 0 ? 1 : roc < 0 ? -1 : 0
var int prevSign = 0
flipUp   = sgn == 1  and prevSign == -1
flipDown = sgn == -1 and prevSign == 1
if sgn != 0
    prevSign := sgn

trendOK = not useAdx  or adxV >= adxMin
rocOK   = not useRocF or math.abs(roc) >= rocMinAtr * atr14
buySig  = flipUp   and trendOK and rocOK
sellSig = flipDown and trendOK and rocOK

// ── SL กันหายนะ: buffer กว้างกว่าปกติ (ไม่ใช่จุดออกหลัก) cap 5×ATR ──────────
disasterRisk(anchor, isBuy) =>
    usable = not na(anchor) and (isBuy ? anchor < close : anchor > close)
    usable ? math.min(math.max(math.abs(close - anchor) + slBuf * atr14, 0.3 * atr14), 5.0 * atr14)
           : math.max(2.0, slBuf) * atr14

// ── Entry + state ───────────────────────────────────────────────────────────
var float risk0  = na   // risk ตอนเข้า (คำนวณ partialR)
var float curSL  = na   // stop ปัจจุบัน (ratchet ได้ขึ้น/ลงฝั่งกำไรเท่านั้น)
var float tp1    = na   // limit ของ PARTIAL
var float maxFav = na   // extreme ตั้งแต่เข้า (high สูงสุด / low ต่ำสุด)

if buySig
    risk0  := disasterRisk(swingLo, true)
    curSL  := close - risk0
    tp1    := close + partialR * risk0
    maxFav := high
    strategy.entry("BUY", strategy.long)
if sellSig
    risk0  := disasterRisk(swingHi, false)
    curSL  := close + risk0
    tp1    := close - partialR * risk0
    maxFav := low
    strategy.entry("SELL", strategy.short)

// ── Exit engine: อัปเดต stop ทุกแท่ง + วาง exit ตามโหมด ────────────────────
isLong  = strategy.position_size > 0
isShort = strategy.position_size < 0
if isLong
    maxFav := math.max(maxFav, high)
    if exitMode != "FLIP"
        curSL := math.max(curSL, maxFav - trailMult * atr14)
    if exitMode == "PARTIAL"
        strategy.exit("BUY-TP1", "BUY", limit=tp1, qty_percent=50)
        strategy.exit("BUY-RUN", "BUY", stop=curSL)
    else
        strategy.exit("BUY-X", "BUY", stop=curSL)
if isShort
    maxFav := math.min(maxFav, low)
    if exitMode != "FLIP"
        curSL := math.min(curSL, maxFav + trailMult * atr14)
    if exitMode == "PARTIAL"
        strategy.exit("SELL-TP1", "SELL", limit=tp1, qty_percent=50)
        strategy.exit("SELL-RUN", "SELL", stop=curSL)
    else
        strategy.exit("SELL-X", "SELL", stop=curSL)

// ── Plots ───────────────────────────────────────────────────────────────────
inPos = strategy.position_size != 0
bgcolor(not trendOK ? color.new(#F85149, 94) : na, title="no-trend zone (ADX ต่ำ)")
plotshape(buySig,  "BUY",  shape.triangleup,   location.belowbar, color.new(#26A69A, 0), size=size.small, text="BUY")
plotshape(sellSig, "SELL", shape.triangledown, location.abovebar, color.new(#EF5350, 0), size=size.small, text="SELL")
plot(inPos ? strategy.position_avg_price : na, "Entry", color.new(#58A6FF, 0), 1, plot.style_linebr)
plot(inPos ? curSL : na, "Stop (SL/trailing)", color.new(#F85149, 0), 1, plot.style_linebr)
plot(inPos and exitMode == "PARTIAL" ? tp1 : na, "TP1 (50%)", color.new(#3FB950, 0), 1, plot.style_linebr)
plot(roc,  "ROC (data window)", color.new(#D29922, 0), 1, plot.style_line, display=display.data_window)
plot(adxV, "ADX (data window)", color.new(#A371F7, 0), 1, plot.style_line, display=display.data_window)

// ── Dashboard ───────────────────────────────────────────────────────────────
var table dash = table.new(position.top_right, 2, 8, bgcolor=color.new(#0D1117, 15), border_width=1, border_color=color.new(#30363D, 0))
if barstate.islastconfirmedhistory or barstate.isrealtime
    closed = strategy.closedtrades
    wr = closed > 0 ? 100.0 * strategy.wintrades / closed : na
    pf = strategy.grossloss != 0 ? strategy.grossprofit / math.abs(strategy.grossloss) : na
    table.cell(dash, 0, 0, "TSMOM-FX · ROC " + str.tostring(lookback), text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 0, "Exit: " + exitMode + (exitMode == "TRAIL" ? " " + str.tostring(trailMult) + "×ATR" : exitMode == "PARTIAL" ? " @" + str.tostring(partialR) + "R" : ""), text_color=color.gray, text_size=size.small)
    table.cell(dash, 0, 1, "Trades", text_color=#8B949E, text_size=size.small)
    table.cell(dash, 1, 1, str.tostring(closed), text_color=color.white, text_size=size.small)
    table.cell(dash, 0, 2, "Win rate", text_color=#8B949E, text_size=size.small)
    table.cell(dash, 1, 2, na(wr) ? "—" : str.tostring(wr, "#.#") + "%", text_color=color.white, text_size=size.small)
    table.cell(dash, 0, 3, "Profit factor", text_color=#8B949E, text_size=size.small)
    table.cell(dash, 1, 3, na(pf) ? "—" : str.tostring(pf, "#.##"), text_color=(not na(pf)) and pf > 1 ? #3FB950 : #F85149, text_size=size.small)
    table.cell(dash, 0, 4, "Net profit", text_color=#8B949E, text_size=size.small)
    table.cell(dash, 1, 4, str.tostring(strategy.netprofit, "#.##"), text_color=strategy.netprofit > 0 ? #3FB950 : #F85149, text_size=size.small)
    table.cell(dash, 0, 5, "Filter", text_color=#8B949E, text_size=size.small)
    table.cell(dash, 1, 5, (useAdx ? "ADX≥" + str.tostring(adxMin, "#") + " (" + str.tostring(adxV, "#.#") + ")" : "ADX off") + " · " + (useRocF ? "|ROC|≥" + str.tostring(rocMinAtr) + "×ATR" : "ROC off") + (trendOK and rocOK ? " · PASS" : " · BLOCK"), text_color=trendOK and rocOK ? #3FB950 : #D29922, text_size=size.small)
    table.cell(dash, 0, 6, "Open stop", text_color=#8B949E, text_size=size.small)
    table.cell(dash, 1, 6, inPos ? str.tostring(curSL, format.mintick) : "—", text_color=color.white, text_size=size.small)
    table.cell(dash, 0, 7, "Position", text_color=#8B949E, text_size=size.small)
    table.cell(dash, 1, 7, isLong ? "LONG" : isShort ? "SHORT" : "FLAT", text_color=isLong ? #3FB950 : isShort ? #F85149 : #8B949E, text_size=size.small)

// ── Alerts — ตั้งใน TV ด้วยเงื่อนไข "alert() function calls only" ──────────
if buySig
    alert("TSMOM-FX BUY @ " + str.tostring(close, format.mintick), alert.freq_once_per_bar_close)
if sellSig
    alert("TSMOM-FX SELL @ " + str.tostring(close, format.mintick), alert.freq_once_per_bar_close)
