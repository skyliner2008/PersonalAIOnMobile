//@version=6
// ═══════════════════════════════════════════════════════════════════════════
//  03 · Short-Term Reversal — RSI สุดโต่ง + แตะ Bollinger Band (edge-triggered)
//  Mirror ของ PersonalAIBot: SignalMarkerProvider.kt (REV) + StrategyParams.kt
//  Entry : แท่งแรกที่ RSI < rsiLow และ close ≤ BB lower (แท่งก่อนไม่เข้าเงื่อนไข) → BUY
//          แท่งแรกที่ RSI > rsiHigh และ close ≥ BB upper → SELL
//  SL    : swing สุดขอบ 10 แท่ง + slBuf×ATR14, clamp [0.3, 3.5] แล้ว cap 2.5×ATR14
//          (mean reversion ไม่ถือขาดทุนลึก)
//  TP    : BB basis (SMA ของ BB) ถ้าอยู่ฝั่งกำไร — ไม่ใช่ → tpMult×ATR14 (fallback)
// ═══════════════════════════════════════════════════════════════════════════
strategy("03 · Short-Term Reversal — RSI+BB [PAIBot]", shorttitle="REV", overlay=true,
     initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100,
     process_orders_on_close=true, calc_on_every_tick=false)

// ── Inputs ──────────────────────────────────────────────────────────────────
rsiPeriod = input.int(14,     "RSI period",            minval=2,   group="Entry")
rsiLow    = input.float(30.0, "RSI oversold",          step=1.0,   group="Entry")
rsiHigh   = input.float(70.0, "RSI overbought",        step=1.0,   group="Entry")
bbPeriod  = input.int(20,     "BB period",             minval=2,   group="Entry")
bbMult    = input.float(2.0,  "BB mult (σ)",           step=0.1,   group="Entry")
swingLen  = input.int(10,     "Swing lookback (bars)", minval=2,   group="SL / TP")
slBuf     = input.float(0.5,  "SL buffer (×ATR14)",    step=0.1,   group="SL / TP")
slCap     = input.float(2.5,  "SL cap (×ATR14)",       step=0.1,   group="SL / TP")
tpMult    = input.float(1.5,  "TP fallback (×ATR14)",  step=0.1,   group="SL / TP")

// ── Indicators ──────────────────────────────────────────────────────────────
atr14 = ta.atr(14)
rsiV  = ta.rsi(close, rsiPeriod)
[basis, upper, lower] = ta.bb(close, bbPeriod, bbMult)   // population σ — ตรง Kotlin
swingLo = ta.lowest(low, swingLen)[1]
swingHi = ta.highest(high, swingLen)[1]

// ── Entry: EDGE — แท่งแรกที่เข้าเงื่อนไขเท่านั้น ────────────────────────────
bullNow = rsiV < rsiLow  and close <= lower
bearNow = rsiV > rsiHigh and close >= upper
buySig  = bullNow and not bullNow[1]
sellSig = bearNow and not bearNow[1]

// ── SL/TP ───────────────────────────────────────────────────────────────────
structRisk(anchor, isBuy) =>
    usable = not na(anchor) and (isBuy ? anchor < close : anchor > close)
    raw = usable ? math.min(math.max(math.abs(close - anchor) + slBuf * atr14, 0.3 * atr14), 3.5 * atr14)
                 : math.max(1.5, slBuf) * atr14
    math.min(raw, slCap * atr14)   // REV cap — ไม่รับ risk ลึกเกิน

var float sl = na
var float tp = na
if buySig
    risk = structRisk(swingLo, true)
    sl := close - risk
    tp := basis > close ? basis : close + tpMult * atr14   // กลับสู่เส้นกลาง
    strategy.entry("BUY", strategy.long)
    strategy.exit("BUY-EXIT", from_entry="BUY", stop=sl, limit=tp)
if sellSig
    risk = structRisk(swingHi, false)
    sl := close + risk
    tp := basis < close ? basis : close - tpMult * atr14
    strategy.entry("SELL", strategy.short)
    strategy.exit("SELL-EXIT", from_entry="SELL", stop=sl, limit=tp)

// ── Plots ───────────────────────────────────────────────────────────────────
inPos = strategy.position_size != 0
plot(basis, "BB basis", color.new(#8B949E, 30), 1)
plot(upper, "BB upper", color.new(#F778BA, 40), 1)
plot(lower, "BB lower", color.new(#58A6FF, 40), 1)
plotshape(buySig,  "BUY",  shape.triangleup,   location.belowbar, color.new(#66BB6A, 0), size=size.small, text="BUY")
plotshape(sellSig, "SELL", shape.triangledown, location.abovebar, color.new(#E57373, 0), size=size.small, text="SELL")
plot(inPos ? strategy.position_avg_price : na, "Entry", color.new(#58A6FF, 0), 1, plot.style_linebr)
plot(inPos ? sl : na, "SL", color.new(#F85149, 0), 1, plot.style_linebr)
plot(inPos ? tp : na, "TP", color.new(#3FB950, 0), 1, plot.style_linebr)

// ── Dashboard ───────────────────────────────────────────────────────────────
var table dash = table.new(position.top_right, 2, 7, bgcolor=color.new(#0D1117, 15), border_width=1, border_color=color.new(#30363D, 0))
if barstate.islast
    closed = strategy.closedtrades
    wr = closed > 0 ? 100.0 * strategy.wintrades / closed : na
    pf = strategy.grossloss != 0 ? strategy.grossprofit / math.abs(strategy.grossloss) : na
    table.cell(dash, 0, 0, "REV · RSI" + str.tostring(rsiPeriod) + " " + str.tostring(rsiLow, "#") + "/" + str.tostring(rsiHigh, "#") + " BB" + str.tostring(bbPeriod), text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 0, "SL swing+" + str.tostring(slBuf) + "×ATR (cap " + str.tostring(slCap) + ") · TP=BB basis", text_color=color.gray, text_size=size.small)
    table.cell(dash, 0, 1, "Trades", text_color=#8B949E, text_size=size.small)
    table.cell(dash, 1, 1, str.tostring(closed), text_color=color.white, text_size=size.small)
    table.cell(dash, 0, 2, "Win rate", text_color=#8B949E, text_size=size.small)
    table.cell(dash, 1, 2, na(wr) ? "—" : str.tostring(wr, "#.#") + "%", text_color=color.white, text_size=size.small)
    table.cell(dash, 0, 3, "Profit factor", text_color=#8B949E, text_size=size.small)
    table.cell(dash, 1, 3, na(pf) ? "—" : str.tostring(pf, "#.##"), text_color=(not na(pf)) and pf > 1 ? #3FB950 : #F85149, text_size=size.small)
    table.cell(dash, 0, 4, "Net profit", text_color=#8B949E, text_size=size.small)
    table.cell(dash, 1, 4, str.tostring(strategy.netprofit, "#.##"), text_color=strategy.netprofit > 0 ? #3FB950 : #F85149, text_size=size.small)
    table.cell(dash, 0, 5, "Open SL / TP", text_color=#8B949E, text_size=size.small)
    table.cell(dash, 1, 5, inPos ? str.tostring(sl, format.mintick) + " / " + str.tostring(tp, format.mintick) : "—", text_color=color.white, text_size=size.small)
    table.cell(dash, 0, 6, "Position", text_color=#8B949E, text_size=size.small)
    table.cell(dash, 1, 6, strategy.position_size > 0 ? "LONG" : strategy.position_size < 0 ? "SHORT" : "FLAT", text_color=strategy.position_size > 0 ? #3FB950 : strategy.position_size < 0 ? #F85149 : #8B949E, text_size=size.small)

// Alerts — ตั้งใน TV ด้วยเงื่อนไข "alert() function calls only"
if buySig
    alert("REV BUY @ " + str.tostring(close, format.mintick), alert.freq_once_per_bar_close)
if sellSig
    alert("REV SELL @ " + str.tostring(close, format.mintick), alert.freq_once_per_bar_close)
